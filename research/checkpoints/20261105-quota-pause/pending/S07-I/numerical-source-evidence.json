    {
      "path": "research/upstream/Delft3D/src/utils_lgpl/ec_module/packages/ec_module/src/ec_converter.f90",
      "sha256": "d833fae4657d756238bd7be72ee4b06000d9986826acac4cd7941596fc3ae54d",
      "bytes": 190257,
      "excerpts": [
        {
          "start": 1518,
          "end": 1546,
          "lines": [
            {
              "number": 1518,
              "text": "      ! ===== interpolation ====="
            },
            {
              "number": 1519,
              "text": "      select case (connection%converterPtr%interpolationType)"
            },
            {
              "number": 1520,
              "text": "      case (interpolate_timespace)"
            },
            {
              "number": 1521,
              "text": "         ! === linear interpolation in time ==="
            },
            {
              "number": 1522,
              "text": "         t0 = connection%sourceItemsPtr(1)%ptr%sourceT0FieldPtr%timesteps"
            },
            {
              "number": 1523,
              "text": "         t1 = connection%sourceItemsPtr(1)%ptr%sourceT1FieldPtr%timesteps"
            },
            {
              "number": 1524,
              "text": "         call time_weight_factors(a0, a1, timesteps, t0, t1)"
            },
            {
              "number": 1525,
              "text": "         ! determine windspeed at t=timesteps"
            },
            {
              "number": 1526,
              "text": "         windspeed0 = connection%sourceItemsPtr(1)%ptr%sourceT0FieldPtr%arr1dPtr(1)"
            },
            {
              "number": 1527,
              "text": "         windspeed1 = connection%sourceItemsPtr(1)%ptr%sourceT1FieldPtr%arr1dPtr(1)"
            },
            {
              "number": 1528,
              "text": "         windspeed = a0 * windspeed0 + a1 * windspeed1"
            },
            {
              "number": 1529,
              "text": "         ! determine winddirection at t=timesteps"
            },
            {
              "number": 1530,
              "text": "         winddirection0 = connection%sourceItemsPtr(1)%ptr%sourceT0FieldPtr%arr1dPtr(2)"
            },
            {
              "number": 1531,
              "text": "         winddirection1 = connection%sourceItemsPtr(1)%ptr%sourceT1FieldPtr%arr1dPtr(2)"
            },
            {
              "number": 1532,
              "text": "         winddirection = cyclic_interpolation(winddirection0, winddirection1, a0, a1)"
            },
            {
              "number": 1533,
              "text": "         ! === space conversion using nautical convention ==="
            },
            {
              "number": 1534,
              "text": "         winddirection = (270.0_dp - winddirection) * degrad"
            },
            {
              "number": 1535,
              "text": "         u => connection%targetItemsPtr(1)%ptr%targetFieldPtr%arr1dPtr"
            },
            {
              "number": 1536,
              "text": "         v => connection%targetItemsPtr(2)%ptr%targetFieldPtr%arr1dPtr"
            },
            {
              "number": 1537,
              "text": "         targetU = windspeed * cos(winddirection)"
            },
            {
              "number": 1538,
              "text": "         targetV = windspeed * sin(winddirection)"
            },
            {
              "number": 1539,
              "text": "         select case (connection%converterPtr%operandType)"
            },
            {
              "number": 1540,
              "text": "         case (operand_replace, operand_replace_if_value)"
            },
            {
              "number": 1541,
              "text": "            do i = 1, connection%targetItemsPtr(1)%ptr%elementSetPtr%nCoordinates"
            },
            {
              "number": 1542,
              "text": "               u(i) = targetU"
            },
            {
              "number": 1543,
              "text": "               v(i) = targetV"
            },
            {
              "number": 1544,
              "text": "            end do"
            },
            {
              "number": 1545,
              "text": "            connection%targetItemsPtr(1)%ptr%targetFieldPtr%timesteps = timesteps"
            },
            {
              "number": 1546,
              "text": "            connection%targetItemsPtr(2)%ptr%targetFieldPtr%timesteps = timesteps"
            }
          ]
        }
      ]
    },
    {
      "path": "research/upstream/Delft3D/src/utils_lgpl/ec_module/packages/ec_module/src/ec_provider.F90",
      "sha256": "c5a3ffa61a8c6754e333539399f7dc7e221a3a2a539c0ea341b7fc71498f10f4",
      "bytes": 200496,
      "excerpts": [
        {
          "start": 3366,
          "end": 3378,
          "lines": [
            {
              "number": 3366,
              "text": "   !> Set the TimeFrame's properties, based on a uni* file's header."
            },
            {
              "number": 3367,
              "text": "      !! Headerless column-based ASCII file."
            },
            {
              "number": 3368,
              "text": "      !! uniform: time[minute], wind_x[m s-1](, wind_y[m s-1])"
            },
            {
              "number": 3369,
              "text": "      !! unimagdir: time[minute], windspeed[m s-1], winddirection[degree]"
            },
            {
              "number": 3370,
              "text": "   function ecUniInitializeTimeFrame(fileReaderPtr) result(success)"
            },
            {
              "number": 3371,
              "text": "      logical :: success !< function status"
            },
            {
              "number": 3372,
              "text": "      type(tEcFileReader), pointer :: fileReaderPtr !< FileReader to initialize"
            },
            {
              "number": 3373,
              "text": "      !"
            },
            {
              "number": 3374,
              "text": "      success = .false."
            },
            {
              "number": 3375,
              "text": "      fileReaderPtr%tframe%ec_refdate = fileReaderPtr%tframe%k_refdate"
            },
            {
              "number": 3376,
              "text": "      ! Obtain the total number of timesteps in this file."
            },
            {
              "number": 3377,
              "text": "      rewind (unit=fileReaderPtr%fileHandle)"
            },
            {
              "number": 3378,
              "text": "      success = .true."
            }
          ]
        }
      ]
    }
  ]
}
