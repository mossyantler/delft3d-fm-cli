            {
              "number": 154,
              "text": "      jaQext = 0 !< use Qin externally provided yes or no"
            },
            {
              "number": 155,
              "text": "      jawind = 0 !< use wind yes or no"
            },
            {
              "number": 156,
              "text": "      jastresstowind = 0 !< if jawindstressgiven==1, convert stress to wind yes/no 1/0"
