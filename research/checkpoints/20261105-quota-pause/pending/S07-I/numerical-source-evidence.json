              "number": 159,
              "text": "      call reset_wind()"
            },
            {
              "number": 160,
              "text": "   end subroutine default_wind"
            },
            {
              "number": 161,
              "text": ""
            },
            {
              "number": 162,
              "text": "   !> Resets only wind variables intended for a restart of flow simulation."
            },
            {
              "number": 163,
              "text": "   !! Upon loading of new model/MDU, call default_wind() instead."
            },
            {
              "number": 164,
              "text": "   subroutine reset_wind()"
            },
            {
              "number": 165,
              "text": "      air_pressure_available = .false. !< use air_pressure yes or no"
            },
            {
              "number": 166,
              "text": "      jaspacevarcharn = 0 !< use space varying Charnock coefficients"
            },
            {
              "number": 167,
              "text": "      jawindstressgiven = 0 !< wind stress given in meteo file"
            },
            {
              "number": 168,
              "text": "      ja_airdensity = 0"
            }
          ]
        }
      ]
