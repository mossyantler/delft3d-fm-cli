    {
      "path": "research/upstream/Delft3D/src/engines_gpl/dflowfm/packages/dflowfm_kernel/src/dflowfm_kernel/compute/setcdwcoefficient.f90",
      "sha256": "e5ca48ddfecd50e7176faef6da89f3a665da402c734d9b93627e90e3b9e9a396",
      "bytes": 7279,
      "excerpts": [
        {
          "start": 73,
          "end": 81,
          "lines": [
            {
              "number": 73,
              "text": "      else if (wind_drag_type == CD_TYPE_SMITHBANKE_2PT) then"
            },
            {
              "number": 74,
              "text": ""
            },
            {
              "number": 75,
              "text": "         if (uwi <= wdb(1)) then"
            },
            {
              "number": 76,
              "text": "            cd10 = cdb(1)"
            },
            {
              "number": 77,
              "text": "         else if (uwi <= wdb(2)) then"
            },
            {
              "number": 78,
              "text": "            cd10 = cdb(1) + (uwi - wdb(1)) * (cdb(2) - cdb(1)) / (wdb(2) - wdb(1))"
            },
            {
              "number": 79,
              "text": "         else"
            },
            {
              "number": 80,
              "text": "            cd10 = cdb(2)"
            },
            {
              "number": 81,
              "text": "         end if"
            }
          ]
        }
      ]
    },
    {
      "path": "research/upstream/Delft3D/src/engines_gpl/dflowfm/packages/dflowfm_kernel/src/dflowfm_kernel/compute/setwindstress.f90",
      "sha256": "ee5290147f9b8f65832faa94a4b510f5943106a260e14e5150f876ba6ba15f2d",
      "bytes": 5930,
      "excerpts": [
        {
          "start": 95,
          "end": 142,
          "lines": [
            {
              "number": 95,
              "text": "      if (jawindstressgiven == 0 .or. jastresstowind == 1) then"
            },
            {
              "number": 96,
              "text": "         roa = rhoair"
            },
            {
              "number": 97,
              "text": "         row = rhomean"
            },
            {
              "number": 98,
              "text": "         wdsu = 0.0_dp"
            },
            {
              "number": 99,
              "text": "         numwav = 0"
            },
            {
              "number": 100,
              "text": "         do L = 1, lnx"
            },
            {
              "number": 101,
              "text": "            if (wx(L) /= 0.0_dp .or. wy(L) /= 0.0_dp .or. relativewind > 0) then ! only if some wind"
            },
            {
              "number": 102,
              "text": ""
            },
            {
              "number": 103,
              "text": "               wxL = wx(L)"
            },
            {
              "number": 104,
              "text": "               wyL = wy(L)"
            },
            {
              "number": 105,
              "text": "               if (relativewind > 0.0_dp) then"
            },
            {
              "number": 106,
              "text": "                  uL = relativewind * U1(Ltop(L))"
            },
            {
              "number": 107,
              "text": "                  vL = relativewind * v(Ltop(L))"
            },
            {
              "number": 108,
              "text": "                  uxL = uL * csu(L) - vL * snu(L)"
            },
            {
              "number": 109,
              "text": "                  uyL = uL * snu(L) + vL * csu(L)"
            },
            {
              "number": 110,
              "text": "                  wxL = wxL - uxL"
            },
            {
              "number": 111,
              "text": "                  wyL = wyL - uyL"
            },
            {
              "number": 112,
              "text": "               end if"
            },
            {
              "number": 113,
              "text": "               uwi = sqrt(wxL * wxL + wyL * wyL)"
            },
            {
              "number": 114,
              "text": "               if (jaspacevarcharn == 1) then"
            },
            {
              "number": 115,
              "text": "                  cdb(1) = wcharnock(L)"
            },
            {
              "number": 116,
              "text": "               end if"
            },
            {
              "number": 117,
              "text": "               call setcdwcoefficient(uwi, cdw, L)"
            },
            {
              "number": 118,
              "text": "               if (ice_modify_winddrag /= ICE_WINDDRAG_NONE) then"
            },
            {
              "number": 119,
              "text": "                  local_ice_area_fraction = 0.5_dp * (ice_area_fraction(ln(1, L)) + ice_area_fraction(ln(2, L)))"
            },
            {
              "number": 120,
              "text": "                  cdw = fm_ice_drag_effect(local_ice_area_fraction, cdw)"
            },
            {
              "number": 121,
              "text": "               end if"
            },
            {
              "number": 122,
              "text": "               if (temperature_model == TEMPERATURE_MODEL_COMPOSITE) then"
            },
            {
              "number": 123,
              "text": "                  cdwcof(L) = cdw"
            },
            {
              "number": 124,
              "text": "               end if"
            },
            {
              "number": 125,
              "text": "               if (rho_water_in_wind_stress /= RHO_MEAN) then"
            },
            {
              "number": 126,
              "text": "                  k = ln(2, L)"
            },
            {
              "number": 127,
              "text": "                  row = rho(ktop(k))"
            },
            {
              "number": 128,
              "text": "               end if"
            },
            {
              "number": 129,
              "text": "               if (ja_airdensity + ja_computed_airdensity > 0) then"
            },
            {
              "number": 130,
              "text": "                  k = ln(2, L)"
            },
            {
              "number": 131,
              "text": "                  roa = air_density(k)"
            },
            {
              "number": 132,
              "text": "               end if"
            },
            {
              "number": 133,
              "text": "               tuwi = roa * cdw * uwi"
            },
            {
              "number": 134,
              "text": "               if (jamapwindstress > 0) then"
            },
            {
              "number": 135,
              "text": "                  wdsu_x(L) = tuwi * wxL"
            },
            {
              "number": 136,
              "text": "                  wdsu_y(L) = tuwi * wyL"
            },
            {
              "number": 137,
              "text": "               end if"
            },
            {
              "number": 138,
              "text": "               if (kmx > 0) then"
            },
            {
              "number": 139,
              "text": "                  roro = roa / row"
            },
            {
              "number": 140,
              "text": "                  ustw(L) = sqrt(roro * cdw) * uwi"
            },
            {
              "number": 141,
              "text": "               end if"
            },
            {
              "number": 142,
              "text": "               wdsu(L) = tuwi * (wxL * csu(L) + wyL * snu(L)) / row"
            }
          ]
        }
      ]
    },
